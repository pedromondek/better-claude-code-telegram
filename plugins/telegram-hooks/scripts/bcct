#!/bin/sh
app=${BETTER_CC_TELEGRAM_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/better-claude-code-telegram}
BETTER_CC_TELEGRAM_PLUGIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && cd .. && pwd -P)
export BETTER_CC_TELEGRAM_PLUGIN_DIR

for candidate in "${BETTER_CC_TELEGRAM_BIN:-}" "$app/bin/bcct"; do
  if [ -n "$candidate" ] && [ -f "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

if command -v bcct >/dev/null 2>&1; then
  exec bcct "$@"
fi

setup="npx @pedromondek/better-claude-code-telegram"
echo "bcct: not installed (no launcher in $app/bin). Run: $setup" >&2
echo "bcct: não instalado (sem launcher em $app/bin). Rode: $setup" >&2
exit 1
