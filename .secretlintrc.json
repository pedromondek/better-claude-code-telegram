{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Telegram bot token",
            "patterns": ["/(?<![\\d])\\d{8,10}:[\\w-]{35}(?![\\w-])/"]
          },
          {
            "name": "Google API key",
            "patterns": ["/\\bAIza[\\w-]{35}(?![\\w-])/"]
          }
        ]
      }
    }
  ]
}
