{
  "name": "@pedromondek/better-claude-code-telegram",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram for Claude Code: answer AskUserQuestion with buttons, get a notice when Claude waits on you, and reach every instance on your machine through one bot.",
  "keywords": [
    "claude-code",
    "claude",
    "telegram",
    "plugin",
    "mcp",
    "askuserquestion",
    "chat",
    "tool",
    "utilities",
    "ai-assisted",
    "ai"
  ],
  "homepage": "https://github.com/pedromondek/better-claude-code-telegram#readme",
  "bugs": {
    "url": "https://github.com/pedromondek/better-claude-code-telegram/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedromondek/better-claude-code-telegram.git"
  },
  "license": "Apache-2.0",
  "author": "pedromondek",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "commit": "czg",
    "branch": "node scripts/branch.mjs",
    "merged-pr": "node scripts/merged-pr.mjs",
    "pr:lock": "node scripts/lock-pull-requests.mjs",
    "upstream:watch": "node scripts/watch-upstream.mjs",
    "audit:plugin": "node scripts/audit-plugin.mjs",
    "audit:plugin:issue": "node scripts/audit-plugin.mjs --issue",
    "setup": "node -r ./scripts/require-node.cjs scripts/setup.mjs",
    "setup:language": "node -r ./scripts/require-node.cjs scripts/setup.mjs language",
    "setup:plugin": "node -r ./scripts/require-node.cjs scripts/setup.mjs plugin",
    "setup:token": "node -r ./scripts/require-node.cjs scripts/setup.mjs token",
    "setup:pairing": "node -r ./scripts/require-node.cjs scripts/setup.mjs pairing",
    "setup:delay": "node -r ./scripts/require-node.cjs scripts/setup.mjs delay",
    "setup:quiet-hours": "node -r ./scripts/require-node.cjs scripts/setup.mjs quiet-hours",
    "setup:transcription": "node -r ./scripts/require-node.cjs scripts/setup.mjs transcription",
    "setup:inbox": "node -r ./scripts/require-node.cjs scripts/setup.mjs inbox",
    "setup:statusline": "node -r ./scripts/require-node.cjs scripts/setup.mjs statusline",
    "uninstall": "node -r ./scripts/require-node.cjs scripts/setup.mjs --uninstall",
    "health": "node -r ./scripts/require-node.cjs scripts/health.mjs",
    "dev:binary": "node scripts/dev-install.mjs binary",
    "dev:plugins": "node scripts/dev-install.mjs plugins",
    "dev:install": "node scripts/dev-install.mjs install",
    "telegram": "bash scripts/telegram.sh",
    "telegram:release": "node scripts/release.mjs",
    "lint": "oxlint --max-warnings 0 && eslint --max-warnings 0 && npm run --silent typecheck",
    "lint:oxlint": "oxlint --max-warnings 0",
    "lint:eslint": "eslint --max-warnings 0",
    "lint:fix": "oxlint --fix && eslint --fix",
    "lint:secrets": "secretlint \"**/*\"",
    "lint:lockfile": "node scripts/check-lockfile-sync.mjs && lockfile-lint",
    "lint:typos": "sh scripts/mise-exec.sh typos",
    "lint:plugins": "node scripts/validate-plugins.mjs",
    "tools:lock": "mise lock",
    "release:binary": "node scripts/release-binary.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "release:cliff": "sh scripts/mise-exec.sh git-cliff",
    "release:npm": "node scripts/release-npm.mjs",
    "release:npm:publish": "node scripts/release-npm-publish.mjs",
    "release:pr": "node scripts/release-pr.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "release:version": "node scripts/version.mjs",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "lint:workflows:actionlint": "sh scripts/mise-exec.sh actionlint",
    "lint:workflows:jactionlint": "sh scripts/mise-exec.sh jactionlint --select=workflow-call-permissions,missing-workflow-input,unknown-workflow-input,workflow-input-type,invalid-local-workflow,pipeline-without-pipefail",
    "lint:workflows:zizmor": "sh scripts/mise-exec.sh zizmor --offline --persona=auditor .",
    "lint:workflows:pinact": "sh scripts/mise-exec.sh pinact run --fix=false --no-api",
    "lint:workflows:zizmor:online": "sh scripts/mise-exec.sh zizmor --format=json",
    "lint:workflows:pinact:online": "sh scripts/mise-exec.sh pinact run --check --verify-comment --verify-min-age --format sarif",
    "audit:workflows": "node scripts/workflow-audit.mjs",
    "audit:workflows:issue": "node scripts/workflow-audit-issue.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:file": "prettier --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:all": "npm run --silent test && npm run --silent test:e2e",
    "test:cov": "vitest run --coverage",
    "test:cov:changed": "node scripts/coverage-changed-lines.mjs",
    "test:cov:ratchet": "node scripts/coverage-ratchet.mjs",
    "test:hooks": "vitest run .husky",
    "test:mutation": "node scripts/stryker-run.mjs run",
    "test:mutation:changed": "node scripts/mutation-changed.mjs",
    "test:mutation:prepush": "node scripts/mutation-prepush.mjs",
    "test:mutation:score": "node scripts/mutation-range-score.mjs",
    "test:mutation:baseline": "node scripts/mutation-baseline.mjs",
    "rust:check": "cargo check --manifest-path rust/Cargo.toml --all-targets --locked --quiet --message-format=short",
    "rust:fmt": "cargo fmt --manifest-path rust/Cargo.toml --all --check",
    "rust:fmt:fix": "cargo fmt --manifest-path rust/Cargo.toml --all",
    "rust:clippy": "cargo clippy --manifest-path rust/Cargo.toml --all-targets --locked -- -D warnings",
    "rust:lint": "npm run --silent rust:clippy && npm run --silent rust:fmt",
    "rust:test": "sh scripts/mise-exec.sh cargo nextest run --manifest-path rust/Cargo.toml --locked",
    "rust:bless": "BCCT_BLESS=1 sh scripts/mise-exec.sh cargo nextest run --manifest-path rust/Cargo.toml --locked --test-threads 1 -E 'test(/^blessing_/)' && prettier --write --log-level warn rust/crates/bcct/tests/fixtures",
    "rust:cov": "sh scripts/mise-exec.sh cargo llvm-cov clean --workspace --manifest-path rust/Cargo.toml && sh scripts/mise-exec.sh cargo llvm-cov nextest --manifest-path rust/Cargo.toml --locked --fail-under-lines 100",
    "rust:cov:missing": "sh scripts/mise-exec.sh cargo llvm-cov report --manifest-path rust/Cargo.toml --show-missing-lines",
    "rust:deny": "sh scripts/mise-exec.sh cargo deny --manifest-path rust/Cargo.toml check advisories",
    "rust:mutation": "sh scripts/mise-exec.sh cargo mutants --manifest-path rust/Cargo.toml --in-place --test-tool=nextest --cargo-test-arg=--max-fail=1:immediate",
    "rust:mutation:prepush": "node scripts/rust-mutation-prepush.mjs",
    "rust:build": "cargo clean --manifest-path rust/Cargo.toml --release && cargo build --manifest-path rust/Cargo.toml --release --locked",
    "rust:clean": "cargo clean --manifest-path rust/Cargo.toml",
    "check:private": "node scripts/check-private-data.mjs",
    "check:commit": "sh .husky/lib/check-commit.sh",
    "fixup:fuse": "GIT_SEQUENCE_EDITOR=: git rebase -i --autosquash --keep-base origin/main && npm run --silent check:commit",
    "postinstall": "command -v patch-package >/dev/null 2>&1 || exit 0; patch-package",
    "prepare": "command -v husky >/dev/null 2>&1 || exit 0; husky && node scripts/husky-extra-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-pattern": "13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/instrumenter": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "czg": "1.14.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.88.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "lockfile-lint": "5.1.0",
    "oxlint": "1.88.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.10",
    "secretlint": "13.0.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.1"
    }
  }
}
